// Compiler options shared by every package. Packages are libraries: they emit ESM with
// declarations (tsconfig.build.json) and import their own modules with the .js extension, so the
// output loads in Node and in every bundler without a resolver.
//
// customConditions: inside this workspace a package that imports a sibling (react-i18n imports
// i18n-core) reads the sibling's source through the "@rcooler/source" export condition, so the type
// check, the linter and the tests need no build first and always see the current code. The build
// configs switch the condition off and read the sibling's dist/, like an installed copy.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "customConditions": ["@rcooler/source"],
    "types": [],
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "skipLibCheck": true
  }
}
