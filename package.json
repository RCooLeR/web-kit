{
  "name": "@rcooler/web-kit",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace of the @rcooler TypeScript packages: theme tokens, formatting, i18n, HTTP, Web Push and React components.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^26.13.1",
    "npm": ">=11.20.0 <12"
  },
  "workspaces": [
    "packages/tokens",
    "packages/format",
    "packages/i18n-core",
    "packages/http",
    "packages/webpush",
    "packages/react-ui",
    "packages/react-admin",
    "packages/react-signin",
    "packages/react-i18n"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "check:consumers": "node ./node_modules/typescript/bin/tsc6 --noEmit -p consumer-check/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:consumers"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "bootstrap": "5.3.9",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  }
}
