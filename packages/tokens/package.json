{
  "name": "@rcooler/tokens",
  "version": "0.1.0",
  "description": "A theme as Bootstrap 5 variable overrides, light and dark, with a JSON export.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@rcooler/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RCooLeR/web-kit.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.build.json && node scripts/write-assets.mjs",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json"
  }
}
