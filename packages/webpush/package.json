{
  "name": "@rcooler/webpush",
  "version": "0.1.0",
  "description": "Web Push in the browser: subscribe, resubscribe after a key change, and the service worker handlers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@rcooler/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "@rcooler/source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RCooLeR/web-kit.git",
    "directory": "packages/webpush"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json"
  }
}
