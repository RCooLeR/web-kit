{
  "name": "@rcooler/react-ui",
  "version": "0.2.0",
  "description": "The shared look of the web apps: kit.css, the application shell, cards, chips, buttons, forms, tabs, row grids, icons, a modal with focus trap, toasts, a sortable table.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@rcooler/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kit.css": "./dist/kit.css",
    "./brands/*": "./dist/brands/*"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RCooLeR/web-kit.git",
    "directory": "packages/react-ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "scripts": {
    "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json"
  }
}
